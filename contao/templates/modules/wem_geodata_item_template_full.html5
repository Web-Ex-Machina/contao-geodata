<div 
	class="geodata__reader block <?= $this->class ?>" 
	itemprop="location" itemscope 
	itemtype="http://schema.org/Place"
>
	<?php if ($this->picture): ?>
		<div class="geodata__reader__picture img-container">
			<?php $this->insert('image', $this->arrData); ?>
		</div>
	<?php endif; ?>

	<div class="geodata__reader__headline">
		<h1 class="m-right m-bottom-0 ft-notrs" itemprop="name"><?= $this->title ?></h1>
	</div>

	<div class="geodata__reader__text ce_text block" itemprop="description">
		<?= $this->content ?: $this->teaser ?>
	</div>

	<?php if (!empty($this->attributes)): ?>
	<div class="reader__attributes block m-bottom">
		<ul>
			<?php foreach ($this->attributes as $attribute): ?>
			<li><span class="ft-bold"><?= $attribute['attribute'] ?>:</span>&nbsp;<?= $attribute['value'] ?></li>
			<?php endforeach; ?>
		</ul>
	</div>
	<?php endif; ?>

	<!-- contacts -->
	<div class="geodata__reader__contact block m-bottom">
		<?php if($this->phone): ?>
			<div class="map__list__item__line">
				<a href="tel:<?= $this->phone; ?>" rel="nofollow">
					<i class="fas fa-phone fa-lg"></i>&nbsp;<span itemprop="telephone"><?= $this->phone; ?></span>
				</a>
			</div>
		<?php endif; ?>
		<?php if($this->fax): ?>
			<div class="map__list__item__line">
			<a href="fax:<?= $this->fax; ?>" rel="nofollow">
				<i class="fas fa-fax fa-lg"></i>&nbsp;<span itemprop="faxNumber"><?= $this->fax; ?></span>
			</a>
			</div>
		<?php endif; ?>
		<?php if($this->email): ?>
			<div class="map__list__item__line">
			<a href="mailto:<?= $this->email; ?>" rel="nofollow">
				<i class="fa-solid fa-envelope fa-lg"></i>&nbsp;<span itemprop="faxNumber"><?= $this->email; ?></span>
			</a>
			</div>
		<?php endif; ?>
	</div>

	<!-- social networks -->
	<div class="share-buttons__container block m-bottom-x2">
		<?php if($this->website): ?>
			<a href="<?= $this->website; ?>" rel="nofollow" target="_blank" itemprop="sameAs">
				<i class="fal fa-globe fa-2xl"></i>
			</a>
		<?php endif; ?>
		<?php if($this->facebook): ?>
			<a href="<?= $this->facebook; ?>" rel="nofollow" target="_blank">
				<i class="fab fa-facebook fa-2xl"></i>
			</a>
		<?php endif; ?>
		<?php if($this->twitter): ?>
			<a href="<?= $this->twitter; ?>" rel="nofollow" target="_blank">
				<i class="fab fa-twitter fa-2xl"></i>
			</a>
		<?php endif; ?>
		<?php if($this->instagram): ?>
			<a href="<?= $this->instagram; ?>" rel="nofollow" target="_blank">
				<i class="fab fa-instagram fa-2xl"></i>
			</a>
		<?php endif; ?>
	</div>


    <div class="geodata__reader__location">
		<?php if ($this->address): ?>
			<i class="fal fa-map-marker-alt"></i>&nbsp;
			<span itemprop="address" itemscope itemtype="http://schema.org/PostalAddress">
				<?= $this->address ?>
			</span>
		<?php endif; ?>
    </div>

    <?php if (!empty($this->lat) && !empty($this->lng)): ?>
	    <div itemprop="geo" itemscope itemtype="https://schema.org/GeoCoordinates">
	    	<meta itemprop="latitude" content="<?= $this->lat; ?>" />
	    	<meta itemprop="longitude" content="<?= $this->lng; ?>" />
	    </div>


		
    <?php endif; ?>

	<?= $this->map ?>
</div>