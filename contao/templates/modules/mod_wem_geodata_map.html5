<div class="<?php echo $this->class ?> block<?php echo count($this->categories ?? [])<2?' hide-categories':'' ?>">
	<?php if($this->error): ?>
		<div class="error">
			<?php echo $this->msg ?>
		</div>
	<?php else: ?>
		<?php if($this->filters && "above" == $this->filters_position): ?>  
			<div class="geodata__map__filters__container"><?php echo $this->filters_html_; ?></div>
	    <?php endif; ?>
		<div class="geodata__map__wrapper"  style="width: <?php echo $this->config['map']['width'] ?? '100%' ?>; height:<?php echo $this->config['map']['height'] ?? '60vh;' ?>">
			<div class="geodata__map__loading__overlay hidden">
				<div class="geodata__map__loading__overlay__text">
					<?php echo $this->trans('WEM.LOCATIONS.LABEL.mapLoading'); ?>
				</div>
			</div>
			<?php if($this->filters  && "inmap" == $this->filters_position): ?>
				<div class="geodata__map__filters__container">
					<?php echo $this->filters_html_; ?>
				</div>
			<?php endif; ?>
			<div id="map" class="geodata__map__container" style="height:100%">
				<?php if('rightpanel' !== $this->wem_geodata_map_list): ?>
		    		<span class="geodata__map__legend__toggler btn-sm m-0 squared hidden">Legend</span>
					<div class="geodata__map__legend">
						<span class="close"><i class="fal fa-times"></i></span>
					</div>
				<?php endif; ?>
	    	</div>
			<?php if('rightpanel' === $this->wem_geodata_map_list): ?>
				<div class="geodata__map__list__container">
					<?php echo $this->list; ?>
				</div>
			<?php endif; ?>
		</div>
		<?php if($this->filters && "below" == $this->filters_position): ?>  
			<div class="geodata__map__filters__container"><?php echo $this->filters_html_; ?></div>
	    <?php endif; ?>
    	<?php if('below' === $this->wem_geodata_map_list): ?>
			<?php echo $this->list; ?>
		<?php endif; ?>
    	<script type="text/javascript">
			rt                         = '<?php echo $this->rt ?>';
			mapModuleId                = '<?php echo $this->moduleId ?>';
			geodata.blnLoadInAjax      = <?php echo $this->blnLoadInAjax ? 1 : 0; ?>;
			geodata.nbItems            = <?php echo $this->nbItems ? : 0 ?>;
			geodata.nbItemsPerRequest  = <?php echo $this->nbItemsPerRequest ? : 10  ?>;
			geodata.config             = <?php echo json_encode($this->config) ?>;
			geodata.locations          = <?php echo $this->blnLoadInAjax ? '[]' : json_encode($this->locations, JSON_INVALID_UTF8_IGNORE | JSON_INVALID_UTF8_SUBSTITUTE) ?>;
			// geodata.filters            = <?php echo !$this->blnLoadInAjax && $this->filters ? json_encode($this->filters ?? []) : '{}' ?>;
		    geodata.markers.categories = <?php echo $this->categories ? json_encode($this->categories) : '{}' ?>;
		</script>
	<?php endif; ?>
</div>


