<form action="<?= $this->formAction ?>" id="<?= $this->formId ?>" class="tl_form" method="post" enctype="multipart/form-data">
    <div class="tl_formbody_edit">
        <input type="hidden" name="FORM_SUBMIT" value="<?= $this->formId ?>">
