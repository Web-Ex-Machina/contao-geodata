            <div class="widget">
                <h3><?= $this->widgetSettingsTitle ?></h3>
                <label for="update_existing_items">
                    <input type="checkbox" name="update_existing_items" <?= $this->widgetSettingsUpdateChecked ? 'checked' : '' ?>>
                    <?= $this->widgetSettingsUpdateLabel ?>
                </label>
                <br />
                <label for="delete_existing_items_not_in_import_file">
                    <input type="checkbox" name="delete_existing_items_not_in_import_file" <?= $this->widgetSettingsDeleteChecked ? 'checked' : '' ?>>
                    <?= $this->widgetSettingsDeleteLabel ?>
