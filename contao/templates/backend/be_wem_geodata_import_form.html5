                    <?php endforeach ?>
                </tbody>
            </table>
            <br />
            <a class="tl_submit" href="<?= $this->downloadSampleButtonHref ?>" title="<?= $this->downloadSampleButtonTitle ?>">
                <?= $this->downloadSampleButtonLabel ?>
            </a>
        </div>
    </fieldset>

    <fieldset class="tl_tbox nolegend">
