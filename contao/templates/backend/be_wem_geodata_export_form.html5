<div id="tl_buttons">
    <a href="<?= $this->backButtonHref ?>" class="header_back" title="'<?= $this->backButtonTitle ?>" accesskey="b"><?= $this->backButtonLabel ?></a>
</div>

<?= \Contao\Message::generate() ?>

<form action="<?= $this->formAction ?>" id="<?= $this->formId ?>" class="tl_form" method="post" data-turbo="false">
    <div class="tl_formbody_edit">
        <input type="hidden" name="FORM_SUBMIT" value="<?= $this->formId ?>">
        <input type="hidden" name="REQUEST_TOKEN" value="<?= $this->formRequestToken ?>">

        <fieldset class="tl_tbox">
            <legend><?= $this->widgetSettingsTitle ?></legend>

            <div class="widget-group">
                <div class="widget">
                    <fieldset class="tl_radio_container">
                        <legend><?= $this->widgetSettingsFormatLabel ?></legend>
                        <span>
                            <input type="radio" name="format" id="format_xslx" value="xlsx"  class="tl_radio" checked>
                            <label for="format_xslx">XLSX</label>
                        </span>
                        <span>
                            <input type="radio" name="format" id="format_csv" value="csv" class="tl_radio" >
                            <label for="format_csv">CSV</label>
                        </span>
                    </fieldset>
                </div>

                <div class="widget">
                    <div class="tl_checkbox_single_container">
                        <span>
                            <input type="checkbox" id="chk_limit_to_categories" name="chk_limit_to_categories" value="1" class="tl_checkbox">
                            <label for="chk_limit_to_categories"><?= $this->widgetSettingsLimitToCategoriesCheckboxLabel ?></label>
                        </span>
                    </div>
                </div>

                <div class="widget">
                    <div id="limit_to_categories_container" class="hidden">
                        <h3>
                            <label for="limit_to_categories[]"><?= $this->widgetSettingsLimitToCategoriesSelectLabel ?></label>
                        </h3>
                        <select name="limit_to_categories[]" multiple class="tl_select tl_chosen">
                            <?php foreach($this->categories as $id => $label): ?>
                            <option value="<?= $id ?>">
                                <?= $label ?>
                            </option>
                            <?php endforeach ?>
                        </select>
                    </div>
                </div>

                <div class="widget">
                    <div class="tl_checkbox_single_container">
                        <span>
                            <input type="checkbox" id="chk_limit_to_countries" name="chk_limit_to_countries" value="1" class="tl_checkbox">
                            <label for="chk_limit_to_countries"><?= $this->widgetSettingsLimitToCountriesCheckboxLabel ?></label>
                        </span>
                    </div>
                </div>

                <div class="widget">
                    <div id="limit_to_countries_container" class="hidden">
                        <h3>
                            <label for="limit_to_countries[]"><?= $this->widgetSettingsLimitToCountriesSelectLabel ?></label>
                        </h3>
                        <select name="limit_to_countries[]" multiple class="tl_select tl_chosen">
                            <?php foreach($this->countries as $id => $label): ?>
                            <option value="<?= $id ?>">
                                <?= $label ?>
                            </option>
                            <?php endforeach ?>
                        </select>
                    </div>
                </div>
            </div>
        </fieldset>
    </div>

    <div class="tl_formbody_submit">
        <div class="tl_submit_container">
          <input type="submit" name="save" id="save" class="tl_submit" accesskey="s" value="<?= $this->formSubmitValue ?>">
        </div>
    </div>
</form>
<script type="text/javascript">
    document.querySelector('input[name="chk_limit_to_categories"]').addEventListener('click',function(e){
        let select = document.querySelector('select[name="limit_to_categories[]"]');
        let container = document.querySelector('#limit_to_categories_container');
        container.toggleClass('hidden');
        select.required = e.target.checked;
        $('select[name="limit_to_categories[]"]').attr("required",e.target.checked).trigger('chosen:updated');
    });
    document.querySelector('input[name="chk_limit_to_countries"]').addEventListener('click',function(e){
        let select = document.querySelector('select[name="limit_to_countries[]"]');
        let container = document.querySelector('#limit_to_countries_container');
        container.toggleClass('hidden');
        select.required = e.target.checked;
        $('select[name="limit_to_categories[]"]').attr("required",e.target.checked).trigger('chosen:updated');
    });
</script>