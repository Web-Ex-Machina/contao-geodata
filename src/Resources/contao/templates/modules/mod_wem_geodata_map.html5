<div class="<?= $this->class ?> block<?php echo count($this->categories ?? [])<2?' hide-categories':'' ?>">
	<?php if($this->error): ?>
		<div class="error">
			<?= $this->msg ?>
		</div>
	<?php else: ?>
		<?php if($this->filters && "above" == $this->filters_position): ?>  
			<div class="map__filters__container"><?= $this->filters_html; ?></div>
	    <?php endif; ?>
		<div class="map__wrapper"  style="width: <?= $this->config['map']['width'] ?:'100%' ?>; height:<?= $this->config['map']['height'] ?: '60vh;' ?>">
			<div class="map__loading__overlay hidden">
				<div class="map__loading__overlay__text">
					<?= $this->trans('WEM.LOCATIONS.LABEL.mapLoading'); ?>
				</div>
			</div>
			<?php if($this->filters  && "inmap" == $this->filters_position): ?>
				<div class="map__filters__container"><?= $this->filters_html; ?></div>
			<?php endif; ?>
			<div id="map" class="map__container">
				<?php if('rightpanel' !== $this->wem_geodata_map_list): ?>
		    		<span class="map__legend__toggler btn-sm m-0 squared hidden">Legend</span>
					<div class="map__legend">
						<span class="close"><i class="fal fa-times"></i></span>
					</div>
				<?php endif; ?>
	    	</div>
			<?php if('rightpanel' === $this->wem_geodata_map_list): ?>
				<div class="map__list__container">
					<?php echo $this->list; ?>
				</div>
			<?php endif; ?>
		</div>
		<?php if($this->filters && "below" == $this->filters_position): ?>  
			<div class="map__filters__container"><?= $this->filters_html; ?></div>
	    <?php endif; ?>
    	<?php if('below' === $this->wem_geodata_map_list): ?>
			<?php echo $this->list; ?>
		<?php endif; ?>
    	<script type="text/javascript">
			rt                         = '<?= $this->rt ?>';
			mapModuleId                = '<?= $this->moduleId ?>';
			geodata.blnLoadInAjax      = <?= $this->blnLoadInAjax ? 1 : 0; ?>;
			geodata.nbItems            = <?php echo $this->nbItems ? : 0 ?>;
			geodata.nbItemsPerRequest  = <?php echo $this->nbItemsPerRequest ? : 10  ?>;
			geodata.config             = <?= json_encode($this->config) ?>;
			geodata.locations          = <?= $this->blnLoadInAjax ? '[]' : json_encode($this->locations, JSON_INVALID_UTF8_IGNORE | JSON_INVALID_UTF8_SUBSTITUTE) ?>;
			// geodata.filters            = <?= !$this->blnLoadInAjax && $this->filters ? json_encode($this->filters ?? []) : '{}' ?>;
		    geodata.markers.categories = <?= $this->categories ? json_encode($this->categories) : '{}' ?>;
		</script>
	<?php endif; ?>
</div>


